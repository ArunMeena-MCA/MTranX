MTMX_PROVIDER=groq
MTMX_MODEL=openai/gpt-oss-20b
# MTMX_MODEL=groq/compound-mini (may route through rate-limited gpt-oss-120b)
# MTMX_MODEL=gemini-3.6-flash
GROQ_API_KEY=
# GEMINI_API_KEY=

# Automated dashboard's Oracle source (pmtb_msg_dly_msg_out) - see OracleProperties.java.
# ORACLE_DB_PORT defaults to 1521 (Oracle's standard listener port) if left blank.
ORACLE_DB_HOST=
ORACLE_DB_PORT=1521
ORACLE_DB_SERVICE_NAME=
ORACLE_DB_USERNAME=
ORACLE_DB_PASSWORD=

# OBPS/FLEXCUBE file-drop integration - see FlexcubeProperties.java. Set FLEXCUBE_ENABLED=true to
# turn on the 5-minute polling job once the rest of these are filled in. FLEXCUBE_BASE_PATH is the
# one folder that already contains the source folder - the other three are created under it
# automatically on first run.
#
# Example from a real path seen on the app server: "/u01/ems/swift/out/12345676497326.txt" means
# FLEXCUBE_BASE_PATH=/u01/ems/swift and FLEXCUBE_MT_OUT_FOLDER=out (NOT "MT_out" - the folder
# name defaults assumed earlier turned out not to match the real deployment, hence these being
# separately configurable rather than fixed).
#
# FLEXCUBE_ACCESS_MODE=local - this backend runs directly ON the FLEXCUBE app server, so
# FLEXCUBE_BASE_PATH is just a plain local filesystem path this process can read/write. Every
# FLEXCUBE_SFTP_* variable below is unused in this mode - leave them blank.
#
# FLEXCUBE_ACCESS_MODE=sftp - this backend runs on a separate machine and reaches FLEXCUBE over
# SFTP; FLEXCUBE_BASE_PATH is then a path on the REMOTE server, and the FLEXCUBE_SFTP_* variables
# below are required. FLEXCUBE_SFTP_PRIVATE_KEY_PATH accepts either an OpenSSH-format key OR a raw
# PuTTY .ppk file directly - no manual conversion needed. FLEXCUBE_SFTP_PASSPHRASE unlocks the key
# file itself; FLEXCUBE_SFTP_PASSWORD is the SEPARATE account password the OBPS server also
# requires (both together - confirmed via a manual WinSCP login that prompted for both).
FLEXCUBE_ENABLED=false
FLEXCUBE_ACCESS_MODE=local
FLEXCUBE_BASE_PATH=
# Override any of these only if the real folder names differ from these defaults (as "out" did).
FLEXCUBE_MT_OUT_FOLDER=MT_out
FLEXCUBE_MT_HISTORY_FOLDER=MT_history
FLEXCUBE_MX_OUT_FOLDER=MX_out
FLEXCUBE_MT_FAILED_FOLDER=MT_failed
FLEXCUBE_POLL_INTERVAL_MS=300000
FLEXCUBE_MIN_FILE_AGE_MS=30000
# Pause between two consecutive files that actually reach the converter (each is an LLM call) -
# set to 0 to disable.
FLEXCUBE_CONVERSION_DELAY_MS=5000
# Local folder (on this backend's own machine) holding failure.json/successful.json, the durable
# record of which source filenames were already counted as failed/succeeded - so a file left in
# the source folder for retry isn't re-counted as a fresh arrival on every cycle.
FLEXCUBE_STATE_DIR=./flexcube-state
# --- sftp mode only, leave blank for local mode ---
FLEXCUBE_SFTP_HOST=
FLEXCUBE_SFTP_PORT=22
FLEXCUBE_SFTP_USERNAME=
FLEXCUBE_SFTP_PRIVATE_KEY_PATH=
FLEXCUBE_SFTP_PASSPHRASE=
FLEXCUBE_SFTP_PASSWORD=
# Optional but recommended - path to a known_hosts file for the OBPS host key. Left blank, host
# key verification is skipped entirely (logged as a warning on every connection).
FLEXCUBE_SFTP_KNOWN_HOSTS_PATH=
# If SFTP auth keeps failing after checking username/password/key, set this to DEBUG for one run to
# see the raw SSH protocol exchange (which auth methods were tried, the server's own responses) -
# far more detail than the summarized error message alone.
FLEXCUBE_SFTP_DEBUG_LOGGING=INFO
