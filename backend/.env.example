MTMX_PROVIDER=groq
MTMX_MODEL=openai/gpt-oss-20b
# MTMX_MODEL=groq/compound-mini (may route through rate-limited gpt-oss-120b)
# MTMX_MODEL=gemini-3.6-flash
GROQ_API_KEY=
# GEMINI_API_KEY=

# Automated dashboard's Oracle source (pmtb_msg_dly_msg_out) - see OracleProperties.java.
# ORACLE_DB_PORT defaults to 1521 (Oracle's standard listener port) if left blank.
ORACLE_DB_HOST=
ORACLE_DB_PORT=1521
ORACLE_DB_SERVICE_NAME=
ORACLE_DB_USERNAME=
ORACLE_DB_PASSWORD=

# OBPS/FLEXCUBE SFTP file-drop integration - see FlexcubeSftpProperties.java. Set
# FLEXCUBE_ENABLED=true to turn on the 5-minute polling job once the rest of these are filled in.
# FLEXCUBE_SFTP_PRIVATE_KEY_PATH accepts either an OpenSSH-format key OR a raw PuTTY .ppk file
# directly - no manual conversion needed. FLEXCUBE_SFTP_PASSPHRASE unlocks the key file itself;
# FLEXCUBE_SFTP_PASSWORD is the SEPARATE account password the OBPS server also requires (both
# together - confirmed via a manual WinSCP login that prompted for both). FLEXCUBE_REMOTE_BASE_PATH
# is the one folder that already contains MT_out - MT_history/MX_out/MT_failed are created under it
# automatically on first run.
FLEXCUBE_ENABLED=false
FLEXCUBE_SFTP_HOST=
FLEXCUBE_SFTP_PORT=22
FLEXCUBE_SFTP_USERNAME=
FLEXCUBE_SFTP_PRIVATE_KEY_PATH=
FLEXCUBE_SFTP_PASSPHRASE=
FLEXCUBE_SFTP_PASSWORD=
# Optional but recommended - path to a known_hosts file for the OBPS host key. Left blank, host
# key verification is skipped entirely (logged as a warning on every connection).
FLEXCUBE_SFTP_KNOWN_HOSTS_PATH=
FLEXCUBE_REMOTE_BASE_PATH=
FLEXCUBE_POLL_INTERVAL_MS=300000
FLEXCUBE_MIN_FILE_AGE_MS=30000
