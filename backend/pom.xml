<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.2.5</version>
        <relativePath/>
    </parent>

    <groupId>com.wiredesk</groupId>
    <artifactId>mtmx-converter</artifactId>
    <version>0.1.0-SNAPSHOT</version>
    <packaging>jar</packaging>
    <name>mtmx-converter</name>
    <description>MT/MX SWIFT message conversion microservice (Prowide-based parsing + mapping-doc-driven conversion)</description>

    <properties>
        <java.version>17</java.version>

        <!--
          NOT VERIFIED: I could not reach Maven Central from this sandbox
          (only a fixed allow-list of domains is reachable here, and
          repo.maven.apache.org / search.maven.org aren't on it), so I
          could not confirm the current published version string for
          Prowide's SWIFT-MT library on Maven Central. Check
          https://mvnrepository.com/artifact/com.prowidesoftware/pw-swift-core
          and set the real latest version before running `mvn compile`.
        -->
        <prowide.core.version>SRU2024-10.2.9</prowide.core.version>
    </properties>

    <dependencies>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>
        <dependency>
            <groupId>com.fasterxml.jackson.dataformat</groupId>
            <artifactId>jackson-dataformat-yaml</artifactId>
        </dependency>

        <!--
          Prowide Core - open-source SWIFT MT parsing/generation library
          (Apache 2.0 licensed at the time this was written). This is the
          library used by parser/MtParserService.java for deterministic,
          spec-aware MT block/field parsing instead of hand-rolled regex.
          VERIFY the groupId/artifactId/version against Maven Central /
          the Prowide docs for the version you actually want to pin -
          see the property comment above.
        -->
        <dependency>
            <groupId>com.prowidesoftware</groupId>
            <artifactId>pw-swift-core</artifactId>
            <version>${prowide.core.version}</version>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
        </plugins>
    </build>
</project>
